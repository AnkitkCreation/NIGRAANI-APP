# === Production-Ready Gitignore ===

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-*

# OS files
Thumbs.db
ehthumbs.db

# Testing
coverage/

# Temporary files
*.temp
*.tmp
*-backup
*-orig

# Cache
.eslintcache
.node_repl_history
*.tsbuildinfo